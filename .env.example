# ─────────────────────────────────────────────────────────────
#  Maison Givrelune — configuration
#  Copier ce fichier en « .env » et compléter.
# ─────────────────────────────────────────────────────────────

# Base de données
#   Dev local (par défaut)  : SQLite, aucun service à installer
#   Production (hébergement gratuit) : PostgreSQL (Neon, Supabase, Railway…)
#   → pour basculer : mettre l'URL postgres ici ET changer
#     `provider = "sqlite"` en `provider = "postgresql"` dans prisma/schema.prisma
DATABASE_URL="file:./givrelune.db"

# Clé de signature des sessions (OBLIGATOIRE en production)
# Générer avec :  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="changez-moi-en-production-avec-une-longue-chaine-aleatoire"

# URL publique du site (utile pour le callback OAuth)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Discord OAuth (facultatif) ──────────────────────────────
# Le bouton « Se connecter avec Discord » n'apparaît que si ces
# deux variables sont renseignées.
# https://discord.com/developers/applications → OAuth2
#   Redirect URI à déclarer : http://localhost:3000/api/auth/discord/callback
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# Facultatif : synchronisation des rôles Discord → rangs du site
# ID du serveur Discord de la Maison
DISCORD_GUILD_ID=""
# Token du bot (permet de lire les rôles du membre à la connexion)
DISCORD_BOT_TOKEN=""
